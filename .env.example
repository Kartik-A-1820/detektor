# Copy to `.env` (docker compose reads it automatically). Every CLI flag of serve.py has a
# DETEKTOR_* equivalent; see docs/reference/CONFIGURATION.md for the full list.

# Model
DETEKTOR_WEIGHTS=/artifacts/model.pt
DETEKTOR_DEVICE=cpu                # auto | cpu | cuda

# Inference defaults
DETEKTOR_CONF_THRESH=0.25
DETEKTOR_IOU_THRESH=0.6
DETEKTOR_MAX_DET=100
DETEKTOR_MAX_CONCURRENCY=1         # simultaneous model executions (keep 1 on small GPUs)

# Security (strongly recommended whenever the port is reachable beyond localhost)
DETEKTOR_API_KEY=                  # set a long random value, e.g. `openssl rand -hex 32`
DETEKTOR_CORS_ORIGINS=             # comma-separated allowed origins; empty = CORS disabled

# Built-in web console
DETEKTOR_UI=false
DETEKTOR_UI_AUTH=                  # user:password; REQUIRED if the UI is exposed

# Operations
DETEKTOR_LOG_LEVEL=INFO
DETEKTOR_PUBLISH_PORT=8000
